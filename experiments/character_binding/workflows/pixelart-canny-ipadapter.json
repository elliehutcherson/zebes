{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" },
    "_meta": { "title": "Load Checkpoint" }
  },
  "15": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "pixel-art-xl.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    },
    "_meta": { "title": "ZEBES_STYLE" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "pixel art, a character", "clip": ["15", 1] },
    "_meta": { "title": "ZEBES_POSITIVE" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "3d render, photo, realistic, blurry, soft shading, gradient, text",
      "clip": ["15", 1]
    },
    "_meta": { "title": "ZEBES_NEGATIVE" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "edge-guide.png" },
    "_meta": { "title": "ZEBES_CONTROL_IMAGE" }
  },
  "5": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "xinsir-controlnet-canny-sdxl-1.0.safetensors"
    },
    "_meta": { "title": "Load Edge ControlNet" }
  },
  "6": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["5", 0],
      "image": ["4", 0],
      "strength": 0.5,
      "start_percent": 0.0,
      "end_percent": 0.6
    },
    "_meta": { "title": "ZEBES_CONTROL_STRENGTH" }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "_meta": { "title": "ZEBES_CANVAS" }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": { "image": "identity.png" },
    "_meta": { "title": "ZEBES_IDENTITY_IMAGE" }
  },
  "12": {
    "class_type": "IPAdapterModelLoader",
    "inputs": { "ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors" },
    "_meta": { "title": "Load IP-Adapter" }
  },
  "13": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors" },
    "_meta": { "title": "Load CLIP Vision" }
  },
  "14": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["15", 0],
      "ipadapter": ["12", 0],
      "image": ["11", 0],
      "clip_vision": ["13", 0],
      "weight": 0.8,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    },
    "_meta": { "title": "ZEBES_IDENTITY_STRENGTH" }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["14", 0],
      "seed": 1,
      "steps": 28,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_image": ["7", 0],
      "denoise": 1.0
    },
    "_meta": { "title": "ZEBES_SEED" }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["1", 2] },
    "_meta": { "title": "Decode" }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "images": ["9", 0], "filename_prefix": "zebes/character-binding" },
    "_meta": { "title": "ZEBES_OUTPUT" }
  }
}
