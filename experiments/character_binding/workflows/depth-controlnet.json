{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" },
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a lone game character, full body, plain flat background",
      "clip": ["1", 1]
    },
    "_meta": { "title": "ZEBES_POSITIVE" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "multiple characters, cropped, text, watermark, grid, sheet, blurry",
      "clip": ["1", 1]
    },
    "_meta": { "title": "ZEBES_NEGATIVE" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "depth-guide.png" },
    "_meta": { "title": "ZEBES_CONTROL_IMAGE" }
  },
  "5": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "xinsir-controlnet-depth-sdxl-1.0.safetensors"
    },
    "_meta": { "title": "Load Depth ControlNet" }
  },
  "6": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["5", 0],
      "image": ["4", 0],
      "strength": 0.55,
      "start_percent": 0.0,
      "end_percent": 0.5
    },
    "_meta": { "title": "ZEBES_CONTROL_STRENGTH" }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "_meta": { "title": "ZEBES_CANVAS" }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "seed": 1,
      "steps": 28,
      "cfg": 8.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_image": ["7", 0],
      "denoise": 1.0
    },
    "_meta": { "title": "ZEBES_SEED" }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["1", 2] },
    "_meta": { "title": "Decode" }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "images": ["9", 0], "filename_prefix": "zebes/character-binding" },
    "_meta": { "title": "ZEBES_OUTPUT" }
  }
}
