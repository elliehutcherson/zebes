# Keep default repository searches focused on first-party, current sources.
# Use an explicit path with `rg --no-ignore` when dependency or archival work
# genuinely requires one of these trees.
/build/
/include/
/notes/
/old/

# Closed plans, experiment evidence, and frozen source snapshots are opt-in.
# Keep experiment implementations, authored specs, and README indexes searchable.
/docs/history/
/experiments/*/out/
/experiments/*/evidence/
/experiments/*/inputs/
/experiments/mouse_3d/*/
/experiments/*/HISTORY.md
/experiments/character_binding/FINDINGS.md
