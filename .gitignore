# Ignore cache folder
.cache/

# Ignore vscode folder
.vscode/

# Ignore build folder
build/

# Python bytecode caches. The asset scripts under scripts/ are loaded by their
# tests via importlib, which writes caches next to the sources.
__pycache__/
*.py[cod]

# macOS Finder metadata
.DS_Store

# ImGui window layout state, rewritten on every editor run
imgui.ini

# Scratch directories that tests create and populate at run time
test_data/

# Character-binding renders, written locally and regenerable from inputs/.
# Nothing under here is tracked. The files the tools consume live in
# experiments/character_binding/inputs/ and the records of closed experiments in
# experiments/character_binding/evidence/, both fully tracked. That split is why
# this is one line instead of an allowlist threading exceptions through an
# ignored tree, which is what it was until 2026-09-06.
experiments/character_binding/out/

# Cross-process authoring locks contain per-machine process metadata.
.zebes/

# Claude Code's per-machine permission allowlist. The rest of .claude/ is
# checked in; this file accumulates absolute paths from whoever ran the tool.
.claude/settings.local.json

# Real API keys. secrets.env.example is the committed template; this is the
# filled-in copy and must never be tracked.
secrets.env
