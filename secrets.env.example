# Template for local credentials. Copy to secrets.env and fill in real values.
#
# secrets.env is gitignored. This template is not, so it must never hold a real
# key.
#
# Nothing loads either file automatically. The credential boundary reads
# environment variables and nothing else, so an unsourced file produces an
# Unauthenticated request rather than a silent default. Load it explicitly:
#
#   set -a; source secrets.env; set +a
#
# See src/editor/image_generation/credential_source.h for the boundary and
# OpenAiImageConfig::credential_reference for which variable an adapter reads.

# Prop artwork generation, in the editor and in the opt-in live provider test.
OPENAI_API_KEY=sk-replace-me
